loadGeneratedPosts();
loadGeneratedImages();
renderCompetitors();
setInterval(()=>{ const a=document.querySelector('.page.active'); if (!a) return; const p=a.getAttribute('data-page'); if(p==='dashboard')loadDashboard(); if(p==='max')loadMaxData(); },30000);

async function checkLeonardoKey() {
    const key = document.getElementById('leonardo-api-key').value.trim();
    if (!key) return;
    try {
        const r = await fetch('https://cloud.leonardo.ai/api/rest/v1/me', {headers:{'Authorization':'Bearer '+key}});
        const data = await r.json();
        const u = data.user_details?.[0];
        if (u) {
            const tokens = (u.subscriptionTokens||0) + (u.apiPaidTokens||0);
            alert('✅ Leonardo подключён\nТокены: ' + tokens + ' (дневных: ' + (u.subscriptionTokens||0) + ', платных: ' + (u.apiPaidTokens||0) + ')');
        } else { alert('❌ Ошибка: ' + JSON.stringify(data)); }
    } catch(e) { alert('❌ Ошибка: ' + e.message); }
}
