</aside>
<div class="main">
  <div class="topbar">
    <div><div class="topbar-title" id="topbar-title">Дашборд</div></div>
    <div class="topbar-actions">
      <button class="btn btn-ghost btn-sm" onclick="refreshPage()">↻ Обновить</button>
