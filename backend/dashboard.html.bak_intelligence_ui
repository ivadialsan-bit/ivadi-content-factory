    document.getElementById('db-today').textContent = stats.today_count;
    const q = await fetch(API+'/api/ivadi/queue').then(r=>r.json());
    document.getElementById('db-pending').textContent = q.pending;
    const log = document.getElementById('db-log');
    if (stats.recent && stats.recent.length) {
      log.innerHTML = [...stats.recent].reverse().slice(0,8).map(l=>`
        <div class="log-item">
          <div><span class="dot ${l.success?'dot-green':'dot-red'}"></span>
          <span class="type-tag type-${l.type}" style="margin-right:6px">${l.type}</span>
          ${l.topic ? l.topic.substring(0,35)+(l.topic.length>35?'...':'') : '—'}</div>
