  const name=document.getElementById('comp-name').value||url;
  const platform=document.getElementById('comp-platform').value;
  if (!url) { alert('Введите ссылку'); return; }
  competitors.push({url,name,platform,added:new Date().toLocaleString('ru')});
  localStorage.setItem('smm_competitors',JSON.stringify(competitors));
  renderCompetitors();
  document.getElementById('comp-url').value='';
  document.getElementById('comp-name').value='';
}

function renderCompetitors() {
  const el=document.getElementById('competitors-list');
  if (!competitors.length) { el.innerHTML='<div style="color:var(--text-muted);font-size:12px;padding:24px 0;text-align:center">Добавьте первого конкурента</div>'; return; }
  const tags={ВКонтакте:'vk',Instagram:'ig',YouTube:'yt',Telegram:'tg'};
  el.innerHTML=competitors.map((c,i)=>`
    <div class="competitor-card">
      <span class="platform-tag tag-${tags[c.platform]||'vk'}">${c.platform}</span>
      <div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:500">${c.name}</div><div style="font-size:11px;color:var(--text-muted)">${c.url.substring(0,50)}</div></div>
      <div style="display:flex;gap:6px"><button class="btn btn-ghost btn-sm">Анализ</button><button class="btn btn-danger btn-sm" onclick="removeComp(${i})">✕</button></div>
    </div>`).join('');
}

function removeComp(i) { competitors.splice(i,1); localStorage.setItem('smm_competitors',JSON.stringify(competitors)); renderCompetitors(); }

async function updateNicheCounts() {
  try {
    const res = await fetch(API + '/api/analyzer/niches').then(r => r.json());
    const stats = {};
    (res.items || []).forEach(x => { stats[x.niche] = x; });

    ['travel','business','education','entertainment','tech','finance','beauty'].forEach(n=>{
      const el = document.getElementById('nc-'+n);
      const item = stats[n];
      if (!el) return;

      if (!item) {
        el.textContent = '0 единиц';
      } else {
        el.textContent = item.count + ' ед. · ср. ' + item.avg_viral + '/10';
      }
    });
  } catch(e) {
    console.log('niche counts error', e);
  }
}

async function openNiche(n) {
  try {
    const res = await fetch(API + '/api/analyzer/niches/' + n).then(r => r.json());
    const items = res.items || [];
    const el = document.getElementById('niches-recent');
    if (!el) return;

    el.style.textAlign = 'left';
    el.style.padding = '0';

    if (!items.length) {
      el.innerHTML = '<div style="color:var(--text-muted);font-size:12px;padding:20px 0;text-align:center">В этой нише пока нет анализов</div>';
      return;
    }

    el.innerHTML = `
      <div style="padding:0 0 12px 0;font-size:12px;color:var(--text-muted)">
        Показана ниша: <span style="color:var(--accent);font-weight:600">${items[0].niche_label || n}</span>
        · ${items.length} материалов
        · <button class="btn btn-ghost btn-sm" onclick="loadNicheRecent()">Показать все</button>
      </div>
    ` + items.map(x => `
      <div class="log-item">
        <div style="flex:1;min-width:0">
          <span style="font-size:11px;color:var(--yellow);margin-right:8px">${x.viral_score || '—'}/10</span>
          <span style="color:var(--accent);margin-right:8px">[${x.niche_label || x.niche || '—'}]</span>
          <span style="font-size:12px">${(x.url || '').substring(0,80)}${(x.url || '').length>80?'...':''}</span>
          <div style="font-size:11px;color:var(--text-muted);margin-top:4px">${x.hook_type || ''}</div>
        </div>
        <span style="font-size:11px;color:var(--text-muted);flex-shrink:0">${x.created_at || ''}</span>
      </div>
    `).join('');
  } catch(e) {
    console.log('open niche error', e);
  }
}

async function loadNicheRecent() {
  try {
    const res = await fetch(API + '/api/analyzer/history').then(r => r.json());
    const items = (res.items || []).slice(0, 10);
    const el = document.getElementById('niches-recent');
    if (!el) return;

    if (!items.length) {
      el.innerHTML = 'Анализируйте контент — он попадёт сюда';
      return;
    }

    el.style.textAlign = 'left';
    el.style.padding = '0';

    el.innerHTML = items.map(x => `
      <div class="log-item">
        <div style="flex:1;min-width:0">
          <span style="font-size:11px;color:var(--yellow);margin-right:8px">${x.viral_score || '—'}/10</span>
          <span style="color:var(--accent);margin-right:8px">[${x.niche_label || x.niche || '—'}]</span>
          <span style="font-size:12px">${(x.url || '').substring(0,80)}${(x.url || '').length>80?'...':''}</span>
        </div>
        <span style="font-size:11px;color:var(--text-muted);flex-shrink:0">${x.created_at || ''}</span>
      </div>
    `).join('');
  } catch(e) {
    console.log('niche recent error', e);
  }
}

function addNiche() { alert('Добавление своей ниши — в следующей версии'); }
