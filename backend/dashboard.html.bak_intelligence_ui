async function saveGeneratedScenarioAsset() {
  if (!currentGeneratedScenario) return;

  const sc = currentGeneratedScenario;

  const payload = {
    source_analysis_id: currentScenarioAnalysisId,
    title: sc.title || '',
    hook: sc.hook || '',
    script: Array.isArray(sc.script) ? sc.script : [],
    voiceover: sc.voiceover || '',
    visual_style: sc.visual_style || '',
    cta: sc.cta || ''
  };

  try {
    const res = await fetch(API + '/api/analyzer/assets', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    }).then(r => r.json());

    const box = document.getElementById('scenario-save-status');
    if (box) {
      box.textContent = res.success ? 'Сценарий сохранён в библиотеку' : 'Ошибка сохранения';
      box.style.color = res.success ? 'var(--green)' : 'var(--red)';
    }
  } catch(e) {
    const box = document.getElementById('scenario-save-status');
    if (box) {
      box.textContent = 'Ошибка: ' + e.message;
      box.style.color = 'var(--red)';
    }
  }
}


