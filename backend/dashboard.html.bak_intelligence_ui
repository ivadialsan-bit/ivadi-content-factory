function escapeHtml(v) {
  return String(v || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function escapeAttr(v) {
  return escapeHtml(v).replace(/"/g, '&quot;');
}


function goToPage(name) {
  document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const nav = document.querySelector('.nav-item[data-page="'+name+'"]');
  const page = document.querySelector('.page[data-page="'+name+'"]');
  if (nav) nav.classList.add('active');
  if (page) page.classList.add('active');
  if(name==='clients')loadClients();
  document.getElementById('topbar-title').textContent = pageTitles[name] || name;
  if (name === 'dashboard') loadDashboard();
  if (name === 'max') loadMaxData();
}

document.querySelectorAll('.nav-item[data-page]').forEach(item => {
  item.addEventListener('click', () => goToPage(item.getAttribute('data-page')));
});

function refreshPage() {
  const active = document.querySelector('.page.active');
