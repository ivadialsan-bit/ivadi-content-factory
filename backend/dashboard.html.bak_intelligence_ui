  el.style.display='block';
  el.innerHTML='<div style="color:var(--text-muted);font-size:12px">Генерирую...</div>';
  setTimeout(()=>{
    const types=['ВОПРОС','ФАКТ','ИСТОРИЯ','ПРОВОКАЦИЯ','ОБЕЩАНИЕ'];
    const hooks=[
      'Почему 90% людей делают '+topic+' неправильно?',
      'Я потратил год чтобы разобраться в '+topic+'. Вот что узнал',
      'Год назад я ничего не знал про '+topic+'. Сегодня всё изменилось',
