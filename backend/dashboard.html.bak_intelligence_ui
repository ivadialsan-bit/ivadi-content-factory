function generateAvatarScript() { document.getElementById('avatar-text').value='Привет! Сегодня расскажу как путешествовать умнее. За последний год я помог сотням людей найти идеальный тур. Вот главные секреты.'; }

loadDashboard();
updateNicheCounts();
loadNicheRecent();
loadAnalyzerHistory();
