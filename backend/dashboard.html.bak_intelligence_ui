async function analyzeContent() {
  const url = document.getElementById('analyzer-url').value.trim();
  const niche = document.getElementById('analyzer-niche').value;

  if (!url) {
    alert('Вставьте ссылку');
    return;
  }

  try {
    new URL(url);
  } catch (e) {
    alert('Введите корректную ссылку. Пример: https://www.youtube.com/shorts/...');
    return;
  }

  document.getElementById('analyzer-result').style.display = 'none';
  document.getElementById('analyzer-loading').style.display = 'block';
  document.getElementById('analyzer-status').textContent = 'Отправляю в AI-анализ';

  try {
    const res = await fetch(API + '/api/analyzer/analyze', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({url, niche})
    }).then(r => r.json());

    document.getElementById('analyzer-loading').style.display = 'none';

    if (!res.success) {
      alert('Ошибка анализа: ' + (res.error || 'неизвестная ошибка'));
      return;
    }

    const a = res.analysis || {};

    document.getElementById('analyzer-result').style.display = 'block';
    document.getElementById('ar-viral').textContent = (a.viral_score || '—') + '/10';
    document.getElementById('ar-hook').textContent = a.hook_type || '—';
    document.getElementById('ar-duration').textContent = a.content_format || '—';
    document.getElementById('ar-niche').textContent = a.niche_label || a.niche || '—';

    document.getElementById('ar-structure').innerHTML = (a.structure || []).map(x => '• ' + x).join('<br>');
    document.getElementById('ar-triggers').innerHTML = (a.triggers || []).map(x => '• ' + x).join('<br>');
    document.getElementById('ar-why').innerHTML = (a.why_works || []).map(x => '• ' + x).join('<br>');

    let text = '';
    if (a.source_basis) {
      text += 'Источник анализа: ' + a.source_basis + '\n';
      text += 'Точность: ' + (a.source_confidence || 'unknown') + '\n\n';
    }
    text += a.summary || '';

    if (a.video_scenario && a.video_scenario.length) {
      text += '\n\nСценарий видео:\n' + a.video_scenario.map(x => '• ' + x).join('\n');
    }

    if (a.adaptation && a.adaptation.length) {
      text += '\n\nКак адаптировать:\n' + a.adaptation.map(x => '• ' + x).join('\n');
    }

    document.getElementById('ar-transcript').textContent = text;

  } catch (e) {
    document.getElementById('analyzer-loading').style.display = 'none';
    alert('Ошибка запроса: ' + e.message);
  }
}

