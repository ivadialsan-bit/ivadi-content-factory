let currentClientId = null;

async function loadClients() {
  const box = document.getElementById('clients-list');
  if (!box) return;

  try {
    const res = await fetch('/api/clients');
    const clients = await res.json();

    let totalProjects = 0, totalChannels = 0, totalGoals = 0;

    const overviews = await Promise.all(clients.map(async c => {
      try {
        const r = await fetch('/api/clients/' + c.id + '/overview');
        const o = await r.json();
        totalProjects += (o.projects || []).length;
        totalChannels += (o.channels || []).length;
        totalGoals += (o.goals || []).length;
        return {client:c, overview:o};
      } catch {
        return {client:c, overview:{projects:[], channels:[], goals:[], kpis:[]}};
      }
    }));

    document.getElementById('clients-total').innerText = clients.length;
    document.getElementById('clients-projects').innerText = totalProjects;
    document.getElementById('clients-channels').innerText = totalChannels;
    document.getElementById('clients-goals').innerText = totalGoals;

    if (!clients.length) {
      box.innerHTML = `
        <div class="client-empty">
          <div style="font-size:18px;font-weight:800;margin-bottom:8px">Клиентов пока нет</div>
          <div style="margin-bottom:14px">Создай первого клиента и заполни проекты, каналы, цели и KPI.</div>
          <button class="btn btn-primary" onclick="openClientCreateModal()">+ Новый клиент</button>
        </div>`;
      return;
    }

    box.innerHTML = overviews.map(({client:c, overview:o}) => `
      <div class="client-card" onclick="openClientDrawer(${c.id})">
        <div class="client-card-top">
          <div>
            <div class="client-name">${escapeHtml(c.name)}</div>
            <div class="client-meta">${escapeHtml(c.brand || 'Без бренда')} · ${escapeHtml(c.niche || 'Ниша не указана')}</div>
          </div>
          <span class="badge ${c.status === 'archived' ? 'badge-muted' : 'badge-green'}">${statusLabel(c.status)}</span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0">
          <div class="client-stat" style="padding:10px"><div class="num" style="font-size:18px">${(o.projects||[]).length}</div><div class="label">Проекты</div></div>
          <div class="client-stat" style="padding:10px"><div class="num" style="font-size:18px">${(o.channels||[]).length}</div><div class="label">Аккаунты</div></div>
          <div class="client-stat" style="padding:10px"><div class="num" style="font-size:18px">${(o.goals||[]).length}</div><div class="label">Цели</div></div>
        </div>

        <div class="client-meta">${escapeHtml(c.notes || 'Заметок пока нет')}</div>
        <div class="client-actions">
          <button class="btn btn-primary btn-sm" onclick="event.stopPropagation();openClientDrawer(${c.id})">Открыть</button>
          <button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();archiveClient(${c.id})">В архив</button>
        </div>
      </div>
    `).join('');
  } catch (e) {
    box.innerHTML = '<div class="client-empty">Не удалось загрузить клиентов</div>';
  }
}

function openClientCreateModal() {
  ensureClientModal();
  document.getElementById('client-modal').classList.add('open');
}

function closeClientCreateModal() {
  const m = document.getElementById('client-modal');
  if (m) m.classList.remove('open');
}

function ensureClientModal() {
  if (document.getElementById('client-modal')) return;

  document.body.insertAdjacentHTML('beforeend', `
    <div id="client-modal" class="client-drawer" style="right:auto;left:50%;top:50%;transform:translate(-50%,-50%);height:auto;max-height:90vh;width:min(520px,94vw);border-radius:18px;border:1px solid var(--border);display:none">
      <div class="client-drawer-head">
        <div>
          <div style="font-size:22px;font-weight:800">Новый клиент</div>
          <div class="client-sub">Создай базовую карточку клиента</div>
        </div>
        <button class="btn btn-ghost" onclick="closeClientCreateModal()">Закрыть</button>
      </div>
      <div class="client-drawer-body">
        <div class="client-form" style="border:0;padding:0;background:transparent">
          <input id="client-name" placeholder="Название клиента">
          <input id="client-brand" placeholder="Бренд">
          <input id="client-niche" placeholder="Ниша">
          <select id="client-status">
            <option value="active">Активный</option>
            <option value="paused">Пауза</option>
            <option value="archived">Архив</option>
          </select>
          <textarea id="client-notes" placeholder="Заметки: продукт, особенности, ограничения, договорённости"></textarea>
          <button class="btn btn-primary" onclick="createClient()">Создать клиента</button>
          <div id="client-form-message" class="client-sub" style="margin-top:10px"></div>
        </div>
      </div>
    </div>
  `);

  const style = document.createElement('style');
  style.innerHTML = '#client-modal.open{display:block!important;right:auto!important}';
  document.head.appendChild(style);
}

async function createClient() {
  const msg = document.getElementById('client-form-message');
  const name = document.getElementById('client-name').value.trim();

  if (!name) {
    msg.innerText = 'Введите название клиента';
    return;
  }

  const payload = {
    name,
    brand: document.getElementById('client-brand').value.trim(),
    niche: document.getElementById('client-niche').value.trim(),
    status: document.getElementById('client-status').value,
    notes: document.getElementById('client-notes').value.trim()
  };

  const res = await fetch('/api/clients', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(payload)
  });

  if (!res.ok) {
    msg.innerText = 'Не удалось создать клиента';
    return;
  }

  closeClientCreateModal();
  loadClients();
}


let currentClientData = null;

function statusLabel(status) {
  return {active:'Активный', paused:'Пауза', archived:'Архив'}[status || 'active'] || status || 'Активный';
}

function formatClientDate(v) {
  if (!v) return '—';
  try { return new Date(v).toLocaleDateString('ru-RU'); } catch { return '—'; }
}

async function openClientDrawer(id) {
  currentClientId = id;
  const res = await fetch('/api/clients/' + id + '/overview');
  currentClientData = await res.json();
  const c = currentClientData.client;

  ensureClientDrawer();

  document.getElementById('client-drawer-title').innerText = c.name;
  document.getElementById('client-drawer-sub').innerText = `${c.brand || 'Без бренда'} · ${c.niche || 'Ниша не указана'} · ${statusLabel(c.status)}`;

  renderClientWorkspace('overview');
  document.getElementById('client-drawer').classList.add('open');
}

function renderClientWorkspace(tab) {
  const data = currentClientData;
  const c = data.client;

  document.getElementById('client-drawer-tabs').innerHTML = `
