        <div class="stat-card blue"><div class="stat-label">СЕГОДНЯ</div><div class="stat-value" id="db-today">—</div><div class="stat-meta">постов за сегодня</div></div>
        <div class="stat-card yellow"><div class="stat-label">В ОЧЕРЕДИ</div><div class="stat-value" id="db-pending">—</div><div class="stat-meta">ожидают публикации</div></div>
        <div class="stat-card"><div class="stat-label">ПЛАТФОРМЫ</div><div class="stat-value">2</div><div class="stat-meta">активны</div></div>
        <div class="stat-card"><div class="stat-label">ИНТЕГРАЦИИ</div><div class="stat-value">4</div><div class="stat-meta">подключено</div></div>
        <div class="stat-card"><div class="stat-label">АККАУНТЫ</div><div class="stat-value">1</div><div class="stat-meta">ВК активен</div></div>
      </div>
      <div class="grid-2">
        <div class="card"><div class="section-title">Последние публикации</div><div id="db-log"><div style="color:var(--text-muted);font-size:12px;padding:20px 0;text-align:center">Загрузка...</div></div></div>
        <div class="card"><div class="section-title">Статус сервисов</div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><span class="dot dot-green"></span>ВКонтакте API</span><span class="status-badge status-active">активен</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><span class="dot dot-green"></span>MAX Bot</span><span class="status-badge status-active">активен</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><span class="dot dot-green"></span>Claude API</span><span class="status-badge status-active">активен</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><span class="dot dot-green"></span>ivadi-content.service</span><span class="status-badge status-active">активен</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><span class="dot dot-yellow"></span>ElevenLabs</span><span class="status-badge status-soon">не проверен</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><span class="dot dot-muted"></span>HeyGen</span><span class="status-badge status-inactive">не настроен</span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="page" data-page="clients">
      <div class="client-hero">
