  el.innerHTML = pending.map(p=>`
    <div class="queue-item">
      <div class="queue-content">
        <div class="queue-meta">
          <span class="type-tag type-${p.post_type}">${p.post_type}</span>
          <span style="font-size:11px;color:var(--text-muted)">#${p.id}</span>
          ${p.scheduled_time?'<span style="font-size:11px;color:var(--yellow)">🕐 '+p.scheduled_time+'</span>':''}
        </div>
        <div class="queue-topic">${p.topic||'—'}</div>
