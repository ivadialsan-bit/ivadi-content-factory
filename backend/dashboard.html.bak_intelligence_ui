    ${clientTabBtn('projects','Проекты',tab)}
    ${clientTabBtn('channels','Аккаунты',tab)}
    ${clientTabBtn('profile','Профиль',tab)}
    ${clientTabBtn('brief','Бриф',tab)}
    ${clientTabBtn('goals','Цели',tab)}
    ${clientTabBtn('kpis','KPI',tab)}
  `;

  if (tab === 'overview') renderClientOverview(data);
  if (tab === 'projects') renderClientProjects(data);
  if (tab === 'channels') renderClientChannels(data);
  if (tab === 'profile') renderClientProfile(data);
  if (tab === 'brief') renderClientBrief(data);
  if (tab === 'goals') renderClientGoals(data);
  if (tab === 'kpis') renderClientKpis(data);
}

function clientTabBtn(key, label, active) {
  return `<button class="client-tab ${key===active?'active':''}" onclick="renderClientWorkspace('${key}')">${label}</button>`;
