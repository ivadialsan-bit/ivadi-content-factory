<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMM Command Center</title>
<style>
:root {
  --bg: #0a0a0f;
  --bg-card: #111118;
  --bg-hover: #16161f;
  --border: #1e1e2e;
  --border-light: #2a2a3e;
  --text: #e4e4f0;
  --text-muted: #6b6b8a;
  --text-dim: #3a3a55;
  --accent: #7c6af7;
  --accent-glow: rgba(124,106,247,0.15);
  --accent-dim: rgba(124,106,247,0.08);
  --green: #22d3a0;
  --green-dim: rgba(34,211,160,0.12);
  --red: #f87171;
  --red-dim: rgba(248,113,113,0.12);
  --yellow: #fbbf24;
  --yellow-dim: rgba(251,191,36,0.12);
  --blue: #60a5fa;
  --blue-dim: rgba(96,165,250,0.12);
  --pink: #f472b6;
  --sidebar-w: 220px;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { font-size:14px; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }
.sidebar { width: var(--sidebar-w); min-height: 100vh; background: var(--bg-card); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0; overflow-y: auto; z-index: 100; }
.sidebar-logo { padding: 20px 16px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.logo-icon { width: 28px; height: 28px; background: linear-gradient(135deg, var(--accent), #a78bfa); border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 14px; }
.logo-text { font-weight: 700; font-size: 13px; letter-spacing: -0.3px; }
.logo-badge { margin-left: auto; font-size: 9px; padding: 2px 6px; background: var(--accent-dim); color: var(--accent); border-radius: 4px; font-weight: 600; letter-spacing: 0.5px; }
.nav { flex: 1; padding: 8px 0; }
.nav-section { padding: 16px 16px 4px; font-size: 10px; font-weight: 600; color: var(--text-dim); letter-spacing: 1px; text-transform: uppercase; }
.nav-item { display: flex; align-items: center; gap: 9px; padding: 7px 16px; margin: 1px 6px; border-radius: 6px; cursor: pointer; color: var(--text-muted); font-size: 13px; font-weight: 450; transition: all 0.15s; border: 1px solid transparent; }
.nav-item:hover { background: var(--bg-hover); color: var(--text); }
.nav-item.active { background: var(--accent-dim); color: var(--accent); border-color: rgba(124,106,247,0.2); font-weight: 600; }
.nav-item .icon { font-size: 14px; width: 16px; text-align: center; flex-shrink: 0; }
.nav-item .badge { margin-left: auto; font-size: 10px; padding: 1px 6px; border-radius: 10px; font-weight: 600; }
.badge-green { background: var(--green-dim); color: var(--green); }
.badge-muted { background: var(--bg-hover); color: var(--text-muted); }
.sidebar-footer { padding: 12px 16px; border-top: 1px solid var(--border); }
.dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 6px; }
.dot-green { background: var(--green); box-shadow: 0 0 4px var(--green); }
.dot-red { background: var(--red); }
.dot-yellow { background: var(--yellow); }
.dot-muted { background: var(--text-dim); }
.main { margin-left: var(--sidebar-w); flex: 1; min-height: 100vh; display: flex; flex-direction: column; }
.topbar { height: 52px; border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 28px; gap: 12px; position: sticky; top: 0; background: var(--bg); z-index: 50; }
.topbar-title { font-size: 14px; font-weight: 600; }
.topbar-actions { margin-left: auto; display: flex; gap: 8px; align-items: center; }
.content { padding: 28px; flex: 1; }
.page { display: none; }
.page.active { display: block; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
.btn { padding: 7px 14px; border-radius: 6px; border: none; cursor: pointer; font-size: 12px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s; font-family: inherit; }
.btn-primary { background: var(--accent); color: white; }
.btn-primary:hover { background: #6c5ae6; }
.btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--border-light); }
.btn-ghost:hover { background: var(--bg-hover); color: var(--text); }
.btn-sm { padding: 5px 10px; font-size: 11px; }
.btn-danger { background: var(--red-dim); color: var(--red); border: 1px solid rgba(248,113,113,0.2); }
.btn-success { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34,211,160,0.2); }
.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }
.card:hover { border-color: var(--border-light); }
.section-title { font-size: 11px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 16px; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; margin-bottom: 24px; }
.stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; position: relative; overflow: hidden; transition: border-color 0.15s; }
.stat-card:hover { border-color: var(--border-light); }
.stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); opacity: 0.6; }
.stat-card.green::before { background: var(--green); }
.stat-card.blue::before { background: var(--blue); }
.stat-card.yellow::before { background: var(--yellow); }
.stat-card.pink::before { background: var(--pink); }
.stat-label { font-size: 11px; color: var(--text-muted); margin-bottom: 8px; font-weight: 500; }
.stat-value { font-size: 28px; font-weight: 700; line-height: 1; margin-bottom: 4px; letter-spacing: -1px; }
.stat-meta { font-size: 11px; color: var(--text-muted); }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
.grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
.platform-tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; }
.tag-vk { background: rgba(70,128,194,0.15); color: #60a5fa; }
.tag-ig { background: rgba(225,48,108,0.15); color: #f472b6; }
.tag-yt { background: rgba(255,0,0,0.12); color: #f87171; }
.tag-max { background: rgba(0,160,220,0.15); color: #67e8f9; }
.tag-tg { background: rgba(34,197,206,0.15); color: #67e8f9; }
.type-tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; }
.type-lifehack { background: rgba(124,106,247,0.15); color: var(--accent); }
.type-checklist { background: var(--green-dim); color: var(--green); }
.type-honest { background: var(--yellow-dim); color: var(--yellow); }
.type-offer { background: rgba(96,165,250,0.15); color: var(--blue); }
.type-story { background: rgba(244,114,182,0.15); color: var(--pink); }
.type-comparison { background: rgba(251,146,60,0.15); color: #fb923c; }
.type-motivation { background: rgba(34,211,160,0.1); color: var(--green); }
.type-news { background: rgba(248,113,113,0.12); color: var(--red); }
.status-badge { padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; }
.status-active { background: var(--green-dim); color: var(--green); }
.status-inactive { background: var(--red-dim); color: var(--red); }
.status-soon { background: var(--yellow-dim); color: var(--yellow); }
.queue-item { padding: 14px 16px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; display: flex; align-items: flex-start; gap: 14px; transition: border-color 0.15s; }
.queue-item:hover { border-color: var(--border-light); }
.queue-content { flex: 1; min-width: 0; }
.queue-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; }
.queue-topic { font-size: 13px; font-weight: 500; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.queue-preview { font-size: 12px; color: var(--text-muted); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.queue-actions { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
input[type=text], input[type=password], textarea, select { background: var(--bg); border: 1px solid var(--border-light); border-radius: 6px; color: var(--text); font-family: inherit; font-size: 13px; padding: 8px 12px; outline: none; transition: border-color 0.15s; width: 100%; }
input[type=text]:focus, input[type=password]:focus, textarea:focus, select:focus { border-color: var(--accent); }
input[type=text]::placeholder, textarea::placeholder { color: var(--text-dim); }
textarea { resize: vertical; line-height: 1.6; }
select option { background: var(--bg-card); }
.integration-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 18px; transition: border-color 0.15s; }
.integration-card:hover { border-color: var(--border-light); }
.integration-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.integration-name { font-weight: 600; font-size: 13px; margin-bottom: 3px; }
.integration-desc { font-size: 11px; color: var(--text-muted); }
.competitor-card { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; }
.niche-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; cursor: pointer; transition: all 0.15s; text-align: center; }
.niche-card:hover { border-color: var(--accent); background: var(--accent-dim); }
.niche-icon { font-size: 36px; margin-bottom: 10px; }
.niche-name { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
.niche-count { font-size: 11px; color: var(--text-muted); }
.hook-template { padding: 14px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: all 0.15s; }
.hook-template:hover { border-color: var(--accent); background: var(--accent-dim); }
.hook-type { font-size: 10px; font-weight: 600; color: var(--accent); margin-bottom: 6px; letter-spacing: 0.5px; }
.hook-text { font-size: 13px; line-height: 1.5; }
.platform-header { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
.platform-icon-lg { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
.platform-name { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
.platform-sub { font-size: 12px; color: var(--text-muted); }
.coming-soon { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 40px; text-align: center; border: 1px dashed var(--border-light); border-radius: 12px; background: var(--bg-card); }
.coming-soon-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.6; }
.coming-soon-title { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
.coming-soon-sub { font-size: 13px; color: var(--text-muted); max-width: 320px; line-height: 1.6; }
.avatar-service { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; cursor: pointer; transition: all 0.15s; }
.avatar-service:hover { border-color: var(--border-light); transform: translateY(-1px); }
.avatar-icon { font-size: 32px; margin-bottom: 12px; }
.avatar-name { font-weight: 600; margin-bottom: 4px; }
.avatar-desc { font-size: 11px; color: var(--text-muted); line-height: 1.5; margin-bottom: 12px; }
.log-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px; }
.log-item:last-child { border-bottom: none; }
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }

.client-tabs{display:flex;gap:8px;padding:14px 22px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg-card);z-index:2}
.client-tab{border:1px solid var(--border);background:var(--bg);color:var(--text-muted);border-radius:10px;padding:10px 14px;cursor:pointer;font-weight:700}
.client-tab.active{background:var(--accent-dim);color:var(--accent);border-color:rgba(124,106,247,.45)}
.client-row{display:flex;justify-content:space-between;gap:14px;padding:12px 0;border-bottom:1px solid var(--border)}
.client-row:last-child{border-bottom:0}

</style>

<style id="clients-crm-ui">
.client-hero{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:18px}
.client-title{font-size:22px;font-weight:800;margin-bottom:6px}
.client-sub{color:var(--text-muted);font-size:13px}
.client-stats{display:grid;grid-template-columns:repeat(3,minmax(120px,1fr));gap:12px;margin-bottom:18px}
.client-stat{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px}
.client-stat .num{font-size:24px;font-weight:800}
.client-stat .label{font-size:12px;color:var(--text-muted);margin-top:4px}
.client-layout{display:grid;grid-template-columns:360px 1fr;gap:16px}
.client-form{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:16px}
.client-form input,.client-form textarea,.client-form select{width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:10px;padding:11px 12px;margin-bottom:10px;outline:none}
.client-form textarea{min-height:110px;resize:vertical}
.client-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.client-card{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:16px;cursor:pointer;transition:.15s}
.client-card:hover{transform:translateY(-2px);border-color:rgba(124,106,247,.55)}
.client-card-top{display:flex;justify-content:space-between;gap:10px;margin-bottom:10px}
.client-name{font-size:16px;font-weight:800}
.client-meta{color:var(--text-muted);font-size:12px;line-height:1.5}
.client-actions{display:flex;gap:8px;margin-top:14px}
.client-drawer{position:fixed;top:0;right:-720px;width:min(720px,94vw);height:100vh;background:var(--bg-card);border-left:1px solid var(--border);z-index:10000;box-shadow:-24px 0 80px rgba(0,0,0,.5);transition:.2s;overflow-y:auto}
.client-drawer.open{right:0}
.client-drawer-head{padding:22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.client-drawer-body{padding:22px}
.client-section{border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:14px;background:rgba(255,255,255,.02)}
.client-section-title{font-weight:800;margin-bottom:10px}
.client-mini-form{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;margin-top:10px}
.client-mini-form input,.client-mini-form select{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:10px;padding:10px}
.client-empty{border:1px dashed var(--border);border-radius:14px;padding:24px;text-align:center;color:var(--text-muted)}
@media(max-width:900px){.client-layout{grid-template-columns:1fr}.client-stats{grid-template-columns:1fr}.client-mini-form{grid-template-columns:1fr}}
</style>

</head>
